LCD_DB  EQU  P0
LCD_RW	BIT  P2.5
LCD_RS	BIT  P2.6
LCD_EN  BIT  P2.7
KEY_1	BIT	 ACC.1
KEY_2	BIT	 ACC.0
KEY_3	BIT	 ACC.2
KEY_4	BIT	 ACC.3
DS_IO	BIT  P3.4
DS_EN	BIT  P3.5
DS_CLK	BIT  P3.6
ONLY_1  BIT  0x09
KJDG_0  BIT  0x00
KJDG_1  BIT	 0x01
KJDG_2  BIT  0x02
CMD  EQU  R2		;LCDÖ¸Áî»òÕßDSÉèÖÃµÄÊ±¼äÊý¾Ý
DAT  EQU  R3  
 X   EQU  50H  
 Y   BIT  0x08
ADDR EQU  R6
TYPE EQU  R7
Dat1 EQU  32H
Dat0 EQU  33H
YEAR_0   EQU 34H
YEAR_1	 EQU 35H
MONTH_0  EQU 36H
MONTH_1  EQU 37H
DAY_0    EQU 38H
DAY_1    EQU 39H
HOUR_0   EQU 3AH
HOUR_1   EQU 3BH
MINUTE_0 EQU 3CH
MINUTE_1 EQU 3DH
SECOND_0 EQU 3EH
SECOND_1 EQU 3FH
	
	
	
ORG 0000H
			LJMP MAIN;

ORG 000BH
			LJMP INTER_KEY_PROCESS
			
ORG 001BH
			LJMP INTER_TIME_SHOW
			

ORG 0050H
;LCD_Delay:			;ÑÓÊ±¼ì²éLCDÊÇ·ñ×¼±¸ºÃ
			;MOV LCD_DB,#0xFF
			;SETB LCD_RW
			;CLR  LCD_RS
