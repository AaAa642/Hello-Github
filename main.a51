			;JNC LOOP_Check
			;RET

DELAY_1MS:
    MOV  31H, #2         ;  Íâ²ãÑ­»·¼ÆÊýÆ÷
    NOP                  ;  ¾«Ï¸µ÷Õû
    NOP                  ;  ¾«Ï¸µ÷Õû
OUTER_LOOP: 
    MOV  30H, #122       ;  ÄÚ²ãÑ­»·¼ÆÊýÆ÷
INNER_LOOP:
    DJNZ 30H, INNER_LOOP ;  ÄÚ²ãÑ­»·(247¡Á2=494ÖÜÆÚ)
    DJNZ 31H, OUTER_LOOP ;  Íâ²ãÑ­»·(2¡Á2=4ÖÜÆÚ)
    RET                  ;  ·µ»Ø			


LCD_CMD:			;·¢ËÍÖ¸ÁîCMD
			;LCALL LCD_Delay
			MOV A,#2
DELAY_1:		
			LCALL DELAY_1MS
			DJNZ ACC,DELAY_1
			MOV  LCD_DB,CMD
			CLR  LCD_RW
			CLR  LCD_RS
			CLR  LCD_EN
			SETB LCD_EN
			CLR  LCD_EN
			RET


LCD_DAT:			;·¢ËÍÊý¾ÝDAT

			;LCALL LCD_Delay
			;LCALL LCD_Delay
			MOV A,#2
DELAY_2:		
			LCALL DELAY_1MS
			DJNZ ACC,DELAY_2
			MOV  LCD_DB,DAT
			CLR  LCD_RW
			SETB LCD_RS
			CLR  LCD_EN
			SETB LCD_EN
			CLR  LCD_EN
			RET


LCD_SetCursor_X_Y:	;ÉèÖÃ¹â±ê£¨X,Y£©
			MOV C,Y
			JC S_floor
F_floor:
			MOV A,X
			JMP SetCursor
S_Floor:
			MOV A,X
			ADD A,#0x40
SetCursor:
			ORL A,#0x80
			MOV CMD,A
			LCALL LCD_CMD
			RET


LCD_Show_X_Y_DAT:	;ÏÔÊ¾Êý¾Ý
			LCALL LCD_SetCursor_X_Y
			LCALL LCD_DAT
			RET
			
			
LCD_INIT:			;³õÊ¼»¯
			MOV CMD,#0x38
			LCALL LCD_CMD	;ÅäÖÃ16*2ÏÔÊ¾£¬5*7µãÕó£¬8Î»Êý¾Ý½Ó¿Ú
			MOV CMD,#0x0C	
			LCALL LCD_CMD	;´ò¿ªÏÔÊ¾Æ÷£¬¹Ø±Õ¹â±ê
			MOV CMD,#0x06
			LCALL LCD_CMD	;ÎÄ×Ö²»¶¯£¬µØÖ·×Ô¶¯¼Ó1
			MOV CMD,#0x01
			LCALL LCD_CMD	;ÇåÆÁ
			CLR  Y
			MOV X,#0
			LCALL LCD_SetCursor_X_Y
			MOV DAT,#'D'
			LCALL LCD_DAT
			MOV DAT,#'a'
			LCALL LCD_DAT
			MOV DAT,#'t'
			LCALL LCD_DAT
			MOV DAT,#'e'
			LCALL LCD_DAT
			MOV DAT,#':'
			LCALL LCD_DAT
			MOV X,#7
			LCALL LCD_SetCursor_X_Y
			MOV DAT,#'-'
			LCALL LCD_DAT
			MOV X,#10
			LCALL LCD_SetCursor_X_Y
			MOV DAT,#'-'
			LCALL LCD_DAT
			SETB Y
			MOV X,#0
			LCALL LCD_SetCursor_X_Y
			MOV DAT,#'T'
			LCALL LCD_DAT
			MOV DAT,#'i'
			LCALL LCD_DAT
			MOV DAT,#'m'
			LCALL LCD_DAT
			MOV DAT,#'e'
			LCALL LCD_DAT
			MOV DAT,#':'
			LCALL LCD_DAT
			MOV X,#7
			LCALL LCD_SetCursor_X_Y
			MOV DAT,#':'
			LCALL LCD_DAT
			MOV X,#10
			LCALL LCD_SetCursor_X_Y
			MOV DAT,#':'
			LCALL LCD_DAT
			CLR  Y
			RET


DS1302_READ_TYPE_DAT:
			SETB DS_EN
			MOV A,TYPE
			MOV R0,#8
LOOP_DS_Cmd1:
			RRC A
			MOV DS_IO,C
			SETB DS_CLK
			CLR DS_CLK
			DJNZ R0,LOOP_DS_Cmd1
			SETB DS_IO		;×¼±¸¶ÁÈ¡Êý¾Ý
			MOV R0,#8	
LOOP_DS_READ:
			MOV C,DS_IO
			RRC A
			SETB DS_CLK
			CLR  DS_CLK
			DJNZ R0,LOOP_DS_READ
			MOV DAT,A
			CLR DS_EN
			RET


DS1302_WRITE_TYPE_CMD:
			SETB DS_EN
			MOV A,TYPE
			MOV R0,#8
LOOP_DS_Cmd2:
			RRC A
			MOV DS_IO,C
			SETB DS_CLK
			CLR  DS_CLK
			DJNZ R0,LOOP_DS_Cmd2
			MOV A,CMD		;×¼±¸·¢ËÍÊý¾Ý
			MOV R0,#8
LOOP_DS_WRITE:
			RRC A
			MOV DS_IO,C
			SETB DS_CLK
			CLR  DS_CLK
			DJNZ R0,LOOP_DS_WRITE
			CLR DS_EN
			RET


DS1302_INIT:		;³õÊ¼»¯
			CLR DS_EN
			CLR DS_CLK
			MOV TYPE,#8EH
			MOV CMD,#00H
			LCALL DS1302_WRITE_TYPE_CMD
			MOV TYPE,#8CH
			MOV CMD,#25H
			LCALL DS1302_WRITE_TYPE_CMD
			MOV TYPE,#88H
			MOV CMD,#08H
			LCALL DS1302_WRITE_TYPE_CMD
			MOV TYPE,#86H
			MOV CMD,#22H
			LCALL DS1302_WRITE_TYPE_CMD
			MOV TYPE,#84H
			MOV CMD,#17H
			LCALL DS1302_WRITE_TYPE_CMD
			MOV TYPE,#82H
			MOV CMD,#27H
			LCALL DS1302_WRITE_TYPE_CMD
			MOV TYPE,#80H
			MOV CMD,#00H
			LCALL DS1302_WRITE_TYPE_CMD
			RET
			

BCD_ASCII_DAT_Dat1_Dat0:
			MOV A,DAT
			ANL A,#70H
			RR A
			RR A
			RR A
			RR A
			ADD A,#48
			MOV Dat1,A
			ANL 0x03,#0FH
			MOV A,DAT
			ADD A,#48
			MOV Dat0,A
			RET


BCD_ASCII_DAT_Dat1_Dat0_YEAR:
			MOV A,DAT
			ANL A,#0xF0
			RR A
			RR A
			RR A
			RR A
			ADD A,#48
			MOV Dat1,A
			ANL 0x03,#0FH
			MOV A,DAT
			ADD A,#48
			MOV Dat0,A
			RET


TIME_SHOW:
			LCALL DS1302_READ_TYPE_DAT
			LCALL BCD_ASCII_DAT_Dat1_Dat0
			MOV DAT,Dat1
			LCALL LCD_DAT
			MOV DAT,Dat0
			LCALL LCD_DAT
			RET


TIME_SHOW_YEAR:
			LCALL DS1302_READ_TYPE_DAT
			LCALL BCD_ASCII_DAT_Dat1_Dat0_YEAR
			MOV DAT,Dat1
			LCALL LCD_DAT
			MOV DAT,Dat0
			LCALL LCD_DAT
			RET


KEY_PROCESS_1:			;Ñ¡Ôñ×ßÊ±»¹ÊÇµ÷Ê±£¨²¢ÇÒÐÞ¸Äµ÷½ÚºóµÄÊ±¼ä£©
			PUSH ACC
			CLR TR1
			CPL KJDG_0
			CPL KJDG_1
			CLR KJDG_2
			MOV C,KJDG_0
			JNC RET_1
			MOV CMD,#0FH
			LCALL LCD_CMD
			CLR Y
			MOV X,#8
			LCALL LCD_SetCursor_X_Y
			LJMP RET_1_1
RET_1:
			MOV CMD,#0CH
			LCALL LCD_CMD
			MOV A,SECOND_1
			SUBB A,#30H
			RL A
			RL A
			RL A
			RL A
			;ANL A,#0xF0
			MOV 40H,A
			MOV A,SECOND_0
			SUBB A,#30H
			ADD A,40H
			MOV CMD,A
			MOV TYPE,#80H
			LCALL DS1302_WRITE_TYPE_CMD
			
			MOV A,MINUTE_1
			SUBB A,#48
			RL A
			RL A
			RL A
			RL A
			MOV 41H,A
			MOV A,MINUTE_0
			SUBB A,#48
			ADD A,41H
			MOV CMD,A
			MOV TYPE,#82H
			LCALL DS1302_WRITE_TYPE_CMD
			
			MOV A,HOUR_1
			SUBB A,#48
			RL A
			RL A
			RL A
			RL A
			MOV 41H,A
			MOV A,HOUR_0
			SUBB A,#48
			ADD A,41H
			MOV CMD,A
			MOV TYPE,#84H
			LCALL DS1302_WRITE_TYPE_CMD
			
			MOV A,DAY_1
			SUBB A,#48
			RL A
			RL A
			RL A
			RL A
			MOV 41H,A
			MOV A,DAY_0
			SUBB A,#48
			ADD A,41H
			MOV CMD,A
			MOV TYPE,#86H
			LCALL DS1302_WRITE_TYPE_CMD
			
			MOV A,MONTH_1
			SUBB A,#48
			RL A
			RL A
			RL A
			RL A
			MOV 41H,A
			MOV A,MONTH_0
			SUBB A,#48
			ADD A,41H
			MOV CMD,A
			MOV TYPE,#88H
			LCALL DS1302_WRITE_TYPE_CMD
			
			MOV A,YEAR_1
			SUBB A,#48
			RL A
			RL A
			RL A
			RL A
			MOV 41H,A
			MOV A,YEAR_0
			SUBB A,#48
			ADD A,41H
			MOV CMD,A
			MOV TYPE,#8CH
			LCALL DS1302_WRITE_TYPE_CMD
			
			SETB TR1
RET_1_1:	
			POP ACC
			RET


KEY_PROCESS_2:			;Ñ¡Ôñµ÷Ê±ºó£¬Ñ¡ÔñÊ±¼äÎ»£¬ÉÁË¸
			PUSH ACC
			MOV C,KJDG_1
			JNC RET_2_RELAY
			SETB KJDG_2
			MOV A,X
			CJNE A,#12,RET_2_1
			MOV C,Y
			JNC RET_2_6
