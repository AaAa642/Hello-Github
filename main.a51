			JC RET_2_B
			CLR Y
			MOV X,#12
			LCALL LCD_SetCursor_X_Y
			LJMP RET_2
RET_2_RELAY:
			MOV C,KJDG_1
			JNC RET_2
RET_2_6:
			;CJNE A,#12,RET_2_7
			SETB Y
			MOV X,#5
			LCALL LCD_SetCursor_X_Y
			SJMP RET_2
RET_2_7:
			;CJNE A,#5,RET_2_8
