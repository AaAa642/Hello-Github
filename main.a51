			MOV DAY_0,#39H
GO_D0_DEC:	
			MOV DAT,DAY_0
			LCALL LCD_DAT
			LCALL LCD_SetCursor_X_Y
			SJMP RET_4
RET_4_7:
			;CJNE A,#5,RET_3_8
			DEC HOUR_1
			MOV R4,HOUR_1
			CJNE R4,#2FH,GO_H1_DEC
			MOV HOUR_1,#32H
GO_H1_DEC:
			MOV DAT,HOUR_1
			LCALL LCD_DAT
			LCALL LCD_SetCursor_X_Y
			SJMP RET_4
RET_4_8:
			;CJNE A,#6,RET_3_9
			DEC HOUR_0
			MOV R4,HOUR_0
			CJNE R4,#2FH,GO_H0_DEC
			MOV HOUR_0,#39H
GO_H0_DEC:
			MOV DAT,HOUR_0
			LCALL LCD_DAT
			LCALL LCD_SetCursor_X_Y
			SJMP RET_4
RET_4_RELAY_1:
			MOV C,KJDG_2
			JNC RET_4
RET_4_9:
			;CJNE A,#8,RET_3_A
			DEC MINUTE_1
			MOV R4,MINUTE_1
			CJNE R4,#2FH,GO_MI1_DEC
			MOV MINUTE_1,#36H
GO_MI1_DEC:
			MOV DAT,MINUTE_1
			LCALL LCD_DAT
			LCALL LCD_SetCursor_X_Y
			SJMP RET_4
RET_4_A:
			;CJNE A,#9,RET_3_B
			DEC MINUTE_0
			MOV R4,MINUTE_0
			CJNE R4,#2FH,GO_MI0_DEC
			MOV MINUTE_0,#39H
GO_MI0_DEC:
			MOV DAT,MINUTE_0
			LCALL LCD_DAT
			LCALL LCD_SetCursor_X_Y
			SJMP RET_4
RET_4_B:
			;CJNE A,#11,RET_3_RESET
			DEC SECOND_1
			MOV R4,SECOND_1
			CJNE R4,#2FH,GO_S1_DEC
			MOV SECOND_1,#36H
GO_S1_DEC:
			MOV DAT,SECOND_1
			LCALL LCD_DAT
			LCALL LCD_SetCursor_X_Y
			SJMP RET_4
RET_4_RESET:
			CLR Y
			MOV X,#5
			LCALL LCD_SetCursor_X_Y
RET_4:
			POP ACC
			RET

KEY_INIT:
			MOV P3,#0FH
			MOV R1,#08H
			MOV SP,#60H
			CLR KJDG_0
			CLR KJDG_1
			CLR KJDG_2
			RET


MAIN:
			LCALL KEY_INIT
			LCALL LCD_INIT
			LCALL DS1302_INIT
			MOV TH0,#0xF8
			MOV TL0,#0xCD
			MOV TH1,#0x70
			MOV TL1,#0x00
			MOV 0xA8,#8AH			;Ê¹ÄÜT0,T1ÖÐ¶Ï
			MOV 0x89,#11H			;ÅäÖÃT0,T1 16Î»¶¨Ê±Æ÷Ä£Ê½
			SETB TR0
			SETB TR1
			SJMP $


INTER_TIME_SHOW:
			MOV TH1,#70H
			MOV TL1,#00H
			CLR  Y
			MOV X,#5
			LCALL LCD_SetCursor_X_Y
			MOV TYPE,#8DH
			LCALL TIME_SHOW_YEAR
			MOV YEAR_1,Dat1
			MOV YEAR_0,Dat0
			MOV X,#8
			LCALL LCD_SetCursor_X_Y
			MOV TYPE,#89H
			LCALL TIME_SHOW
			MOV MONTH_1,Dat1
			MOV MONTH_0,Dat0
			MOV X,#11
			LCALL LCD_SetCursor_X_Y
			MOV TYPE,#87H
			LCALL TIME_SHOW
			MOV DAY_1,Dat1
			MOV DAY_0,Dat0
			
			
			SETB Y
			MOV X,#5
			LCALL LCD_SetCursor_X_Y
			MOV TYPE,#85H
			LCALL TIME_SHOW
			MOV HOUR_1,Dat1
			MOV HOUR_0,Dat0
			MOV X,#8
			LCALL LCD_SetCursor_X_Y
			MOV TYPE,#83H
			LCALL TIME_SHOW
			MOV MINUTE_1,Dat1
			MOV MINUTE_0,Dat0
			MOV X,#11
			LCALL LCD_SetCursor_X_Y
			MOV TYPE,#81H
			LCALL TIME_SHOW
			MOV SECOND_1,Dat1
			MOV SECOND_0,Dat0
			RETI
			

INTER_KEY_PROCESS:
			PUSH ACC
			MOV TH0,#0xF8
			MOV TL0,#0xCD
			MOV A,P3
			ANL A,#0FH
			CJNE A,#0FH,JUDGE
			MOV R1,#8
			CLR  ONLY_1
			SJMP RETII
JUDGE:
			CJNE R1,#8,GO_ON
			MOV  R5,A
			DEC  R1
			SJMP RETII
GO_ON:
			DEC R1
			CJNE A,0x05,RETII
			CJNE R1,#0,RETII
			MOV C,ONLY_1
			JC RETII
			MOV R1,#8
			MOV C,KEY_1
			JC GO_ON_1
			LCALL KEY_PROCESS_1
			SETB ONLY_1
GO_ON_1:
			MOV C,KEY_2
			JC GO_ON_2
			LCALL KEY_PROCESS_2
			SETB ONLY_1
GO_ON_2:
			MOV C,KEY_3
			JC GO_ON_3
			LCALL KEY_PROCESS_3
			SETB ONLY_1
GO_ON_3:
			MOV C,KEY_4
			JC RETII
			LCALL KEY_PROCESS_4	
			SETB ONLY_1
RETII:
			POP ACC
			RETI
			
			
END
